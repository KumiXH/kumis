{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ISP Video Opportunity",
  "type": "object",
  "required": ["id", "name_zh", "name_en", "family", "evidence_level", "video_mode", "truth_boundary", "evidence_ids"],
  "properties": {
    "id": {"type": "string"},
    "name_zh": {"type": "string"},
    "name_en": {"type": "string"},
    "family": {"type": "string"},
    "scenarios": {"type": "array", "items": {"type": "string"}},
    "source_type": {"type": "array", "items": {"type": "string"}},
    "evidence_level": {"enum": ["E1", "E2", "E3", "E4", "E5"]},
    "prototype_status": {"type": "string"},
    "video_mode": {"enum": ["preview", "online_recording", "offline_device", "cloud_render"]},
    "input_signals": {"type": "array", "items": {"type": "string"}},
    "pipeline_stage": {"type": "string"},
    "algorithm_family": {"type": "array", "items": {"type": "string"}},
    "temporal_strategy": {"type": "string"},
    "data_needs": {"type": "string"},
    "loss_or_objective": {"type": "string"},
    "quality_metrics": {"type": "array", "items": {"type": "string"}},
    "failure_modes": {"type": "array", "items": {"type": "string"}},
    "truth_boundary": {"enum": ["faithful", "perceptual", "generative"]},
    "feasibility_tags": {"type": "array", "items": {"type": "string"}},
    "novelty": {"type": "string"},
    "video_fit": {"type": "string"},
    "edge_feasibility": {"type": "string"},
    "product_differentiation": {"type": "string"},
    "risk": {"type": "string"},
    "priority": {"type": "string"},
    "evidence_ids": {"type": "array", "items": {"type": "string"}},
    "notes": {"type": "string"},
    "last_verified": {"type": "string"}
  }
}
